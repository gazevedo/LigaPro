# MongoDB Atlas or an authenticated external server: put your private URI in .env.
# Example only: mongodb+srv://USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Leave empty for the API in Docker: Compose uses the local mongodb service.
# For Uvicorn on the host, set mongodb://localhost:27017/?directConnection=true instead.
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=ligapro
CORS_ORIGINS=["http://localhost:8081"]
ENVIRONMENT=development
# Generate a private key with secrets.token_urlsafe(48); never commit the actual value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_WEB_CLIENT_ID=
AUTH_RATE_LIMIT_PER_MINUTE=10
